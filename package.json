{
  "name": "atoms-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Atoms Demo 大仓：client（Next.js 工作台）+ server（Python Agent 服务）",
  "scripts": {
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "test": "npm --prefix client test",
    "dev:server": "node scripts/py.mjs -m uvicorn agent.main:app --app-dir server --port 8100",
    "test:server": "node scripts/py.mjs -m pytest -q server",
    "contract": "node scripts/py.mjs packages/contract/check_contract.py http://127.0.0.1:8100",
    "pack": "node scripts/pack.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
