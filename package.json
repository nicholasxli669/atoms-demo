{
  "name": "atoms-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Atoms Studio 大仓：Web 工作台（Next.js）+ Agent 服务（Python/FastAPI）",
  "scripts": {
    "dev": "npm --prefix apps/studio run dev",
    "build": "npm --prefix apps/studio run build",
    "lint": "npm --prefix apps/studio run lint",
    "test": "npm --prefix apps/studio test",
    "test:agent": "python -m pytest -q apps/agent",
    "contract": "python packages/contract/check_contract.py http://127.0.0.1:8100",
    "dev:agent": "python -m uvicorn agent.main:app --app-dir apps/agent --port 8100 --reload"
  },
  "engines": {
    "node": ">=22"
  }
}
