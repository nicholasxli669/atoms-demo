# 模型（必填与否：不填会自动进入「离线演示模式」，用内置模板跑通全流程）
# 任何 OpenAI 兼容端点都可以：改 LLM_BASE_URL / LLM_MODEL 即可
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 存储（可选）：不填用本地 SQLite 文件 ./data/atoms.db
# 部署到 Serverless（Vercel 等）时指向 Turso，否则数据不持久
# TURSO_DATABASE_URL=libsql://xxxx.turso.io
# TURSO_AUTH_TOKEN=xxxx

# 可选：自定义本地数据库目录（默认 ./data）
# DATA_DIR=./data
