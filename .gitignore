# 大仓（monorepo）：apps/studio = Next.js，apps/agent = Python
# 依赖
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 测试产物
coverage/

# Next.js 构建产物
.next/
out/

# 生产/部署产物
dist/
build/

# Python
apps/agent/.venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# env（保留模板）
.env
.env.*
!.env.example
!**/.env.example

# 运行时数据（SQLite）
data/
apps/studio/data/

# 日志与临时
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts
**/scripts/.out/
**/scripts/.shots/
scripts/.out
scripts/.shots
